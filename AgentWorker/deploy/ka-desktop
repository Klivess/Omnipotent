#!/bin/bash
set -euo pipefail
export DISPLAY=:1 XAUTHORITY=/home/agent/.Xauthority
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
mkdir -p /home/agent/Desktop /home/agent/Downloads /home/agent/.config
touch "$XAUTHORITY"
xauth -f "$XAUTHORITY" add :1 . "$(mcookie)"
/usr/bin/Xtigervnc :1 -geometry 1600x900 -depth 24 -localhost yes -SecurityTypes None -auth "$XAUTHORITY" &
display_pid=$!
trap 'kill "$display_pid" 2>/dev/null || true' EXIT
for attempt in $(seq 1 120); do
  if xdpyinfo -display :1 >/dev/null 2>&1; then break; fi
  sleep 1
done
openbox &
lxpanel &
pcmanfm --desktop &
wait "$display_pid"
