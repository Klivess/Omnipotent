[Unit]
Description=KA computer session control
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ka/session.json
StartLimitIntervalSec=0

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/opt/ka
ExecStart=/usr/bin/python3 -m ka_worker session /etc/ka/session.json
Restart=on-failure
RestartSec=3
UMask=0077
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/agent/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

[Install]
WantedBy=multi-user.target
