[Unit]
Description=KA worker network isolation
After=network-pre.target
Before=ka-broker.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/sbin/nft list table inet ka_isolation >/dev/null 2>&1 || /usr/sbin/nft -f /etc/ka/network.nft'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
