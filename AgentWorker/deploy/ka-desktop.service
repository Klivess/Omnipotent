[Unit]
Description=KA persistent graphical desktop
After=network.target user@1000.service
Wants=user@1000.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent
ExecStart=/usr/local/bin/ka-desktop
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/agent/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
# The session API and independently launched applications are not children of this unit.

[Install]
WantedBy=multi-user.target
