[Unit]
Description=KA persistent computer broker
After=network-online.target incus.service
Wants=network-online.target
RequiresMountsFor=/srv/ka
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ka
ExecStart=/usr/bin/python3 -m ka_worker broker /etc/ka/broker.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
