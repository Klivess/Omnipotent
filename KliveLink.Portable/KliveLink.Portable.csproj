<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>klivelink-agent</AssemblyName>
    <RootNamespace>KliveLink.Portable</RootNamespace>
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>None</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <ProjectReference Include="..\KliveLink.Contracts\KliveLink.Contracts.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="..\KliveLink\Agent\V2\KliveLinkV2Client.cs" Link="V2\KliveLinkV2Client.cs" />
    <Compile Include="..\KliveLink\Protocol\KliveLinkProtocol.cs" Link="Protocol\KliveLinkProtocol.cs" />
  </ItemGroup>
</Project>
